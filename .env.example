# Copiar a .env y completar. Todo lo que está acá tiene default en app/config.py.

# Conexión a la base. Definirla acá es lo que permite sacar la credencial
# hardcodeada del default en app/config.py.
DATABASE_URL=mysql+pymysql://usuario:password@localhost/inmobiliaria_db

# Loguea el SQL con sus parámetros (DNI, email, importes). Solo en desarrollo.
SQL_ECHO=false

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Planilla de recibos y servicio de IPC.
RECIBOS_TEMPLATE=templates/RECIBO INMOBILIARIO.xlsx
IPC_API_URL=https://api.argly.com.ar/v1/ipc?historico=true
IPC_TIMEOUT=10
